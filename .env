# Application Settings
APP_NAME="AI Resume Shortlisting Platform"
DEBUG=True

# Security
JWT_SECRET="your-super-secret-jwt-key-for-dev"
JWT_ALGORITHM="HS256"

# Database (MongoDB)
# Local: mongodb://localhost:27017/ats_db
# Docker: mongodb://mongodb:27017/ats_db
MONGODB_URL="mongodb://localhost:27017/ats_db"

# Storage
STORAGE_DIR="storage"
RESUMES_DIR="storage/resumes"

# ML Configuration (BERT)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
SPACY_MODEL="en_core_web_sm"
FAISS_INDEX_PATH="storage/faiss_index.bin"
FAISS_METADATA_PATH="storage/faiss_metadata.json"

# Ranking Weights
SEMANTIC_WEIGHT=0.7
SKILL_WEIGHT=0.3

# Thresholds
TOP_CANDIDATE_THRESHOLD=0.75
POTENTIAL_CANDIDATE_THRESHOLD=0.50
