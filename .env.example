# Application
APP_NAME="TalentAI ATS Platform"
DEBUG=false

# Security — CHANGE IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# Database
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./ats.db
# PostgreSQL (for Docker/production):
# DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_db

# Storage
STORAGE_DIR=storage
RESUMES_DIR=storage/resumes

# ML Models (downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# FAISS
FAISS_INDEX_PATH=storage/faiss_index.bin
FAISS_METADATA_PATH=storage/faiss_metadata.json

# Ranking weights
SEMANTIC_WEIGHT=0.7
SKILL_WEIGHT=0.3

# Thresholds
TOP_CANDIDATE_THRESHOLD=0.75
POTENTIAL_CANDIDATE_THRESHOLD=0.50
